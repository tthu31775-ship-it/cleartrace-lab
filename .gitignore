# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Python integration examples
__pycache__/
*.pyc

# Sanitized environment documentation
!.env.example

# 自建部署运行期配置(不含秘密模板)
selfhost.env

# lib/data/*.json
# 仓库里内置的是**脱敏示例**（scripts/make-public-demo-data.py 生成）：正文/账号键/昵称/IP 全部替换，
# 计数与结构不变，作用是 clone 之后不接算法包也能 npm run build 并演示 803 条线索。
# 真实数据不要提交，用算法包重新生成：
#   python scripts/prepare-coordination-data.py <cleartrace_algorithm_api>/outputs .
#   python scripts/prepare-douyin-sample.py <抖音数据集目录> lib/data/douyin-sample.json

# 推送凭据兜底(正常情况不在仓库内)
/.push-credential
push-credential
*.token
