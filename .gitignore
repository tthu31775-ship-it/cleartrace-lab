# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Python integration examples
__pycache__/
*.pyc

# Sanitized environment documentation
!.env.example

# 自建部署运行期配置(不含秘密模板)
selfhost.env

# 算法包交付的线索/图谱原始文本(体积大且含评论原文)
# 用 scripts/prepare-coordination-data.py 从算法包 outputs 重新生成:
#   python scripts/prepare-coordination-data.py <cleartrace_algorithm_api>/outputs .
# 抖音公开小样本同理:scripts/prepare-douyin-sample.py
/lib/data/coordination.json
/lib/data/graphs.json
/lib/data/douyin-sample.json

# 推送凭据兜底(正常情况不在仓库内)
/.push-credential
push-credential
*.token
