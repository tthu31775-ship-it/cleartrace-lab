# Proposed Node deployment configuration contract.
# NOT a ready-to-run configuration for the current Sites baseline.
# WorkBuddy must implement and validate these settings first.
# Copy outside the public repository; never fill real secrets in this template.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=https://cleartrace.example.com
DATABASE_PATH=/data/cleartrace.sqlite
AUTH_MODE=session
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
SEED_DEMO_DATA=false

# Enable only behind an exclusive trusted reverse proxy.
# Confirm the exact host-list syntax in the locked Vinext source.
VINEXT_TRUST_PROXY=1
VINEXT_TRUSTED_HOSTS=cleartrace.example.com

# Existing external-model contract: public HTTPS by default.
MODEL_SERVICE_URL=
MODEL_API_KEY=
INTEGRATION_API_TOKEN=

# OWNER_EMAIL belongs to the original Sites bootstrap path.
# CLEARTRACE_SITE_TOKEN belongs to the original Sites gateway.
# The new Node application must not depend on either for browser login.

