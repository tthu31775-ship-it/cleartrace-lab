# 自建部署运行期配置示例（复制为 selfhost.env 后填写,不要把真值提交进仓库）
# selfhost.env 已被 .gitignore 忽略。

NODE_ENV=production
HOST=0.0.0.0
# SQLite 持久目录,必须是持久磁盘而不是容器临时层
DATA_DIR=.wrangler/state

# 首次启动创建管理员(仅当库内没有已激活管理员时执行一次)。
# 密码策略:10–200 位,必须同时包含字母与数字。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 演示站载入合成样例;正式建库改 false
SEED_DEMO_DATA=false

# 会话有效期(秒),默认 28800
SESSION_TTL_SECONDS=28800

# 反向代理后的对外 origin,用于写请求来源校验。
# 若前面有 Nginx/Caddy 且 Host 被改写,必须填准确值,否则所有 POST 会被 403。
APP_ORIGIN=https://cleartrace.example.com

# 可选:外部算法模型(公开 HTTPS,单次超时 20 秒)
MODEL_SERVICE_URL=
MODEL_API_KEY=

# 可选:数据接入服务令牌(建议改用站内签发的可撤销令牌)
INTEGRATION_API_TOKEN=

# 仅在应用只能由可信代理访问、且代理会注入身份头时才开启
TRUST_IDENTITY_HEADERS=false
